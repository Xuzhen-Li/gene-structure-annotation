# =============================================================================
# config/example.env — copy to config/local.env and edit
# =============================================================================
# Beginner path: docs/QUICKSTART.md
# What each stage produces: docs/STAGE_IO.md
#
# MINIMUM for default S1 (RNA + proteins) — fill these first:
#   REPO_ROOT  WORK_DIR  GENOME_FA  GENOME_SOFT  PROTEIN_DB  RNA_BAM
#   BUSCO_LINEAGE  THREADS  RELEASE_TAG  DRAFT_GFF  MERGED_GFF  PROTEINS_FA
# Everything under "S14 CantuLab" can stay as placeholders until you use S14.
# Never commit local.env (private paths / BAMs).
# =============================================================================

ASSEMBLY_OK="no"   # GATE: set "yes" only after Asm1 QC passes (see docs/STAGE_IO.md)
REPO_ROOT="/path/to/gene-structure-annotation"

# Copy to config/local.env — never commit private paths or BAMs.

WORK_DIR="/path/to/work"          # all drafts/qc/release live under here
THREADS=32
MAX_INTRON=25000

GENOME_FA="/path/to/species.hap.fa"          # example was Vitis
GENOME_FASTA="$GENOME_FA"          # alias for S14 / CantuLab scripts
GENOME_SOFT="/path/to/species.hap.softmasked.fa"
GENOME_PREFIX="Species_v1.0"               # rename genes / release labels

# RNA / evidence
RNA_BAM="/path/to/aligned.rna.bam"
ISOSEQ_BAM="/path/to/isoseq.bam"
EXTERNAL_DIR="$WORK_DIR/00-External_evidences/mRNAs"

# Draft engines (S1–S3 / S13)
DRAFT_ENGINE="braker3"            # S1 primary; see docs/steps/MAIN.md
DRAFT_ENGINE_B="gemoma"                 # gemoma|eviann|galba|helixer|liftoff|none
COMPLEASM_LINEAGE="eudicots"
OMARK_OUT="$WORK_DIR/omark"
PROTEIN_DB="/path/to/OrthoDB_eudicots.faa"
REF_FA="/path/to/reference.fa"             # e.g. PN40024 for grape
REF_GFF="/path/to/reference.gff3"
DRAFT_GFF="$WORK_DIR/draft/primary.gff3"
DRAFT_GFF_B="$WORK_DIR/draft/secondary.gff3"

# Merge
MERGE_MODE="evm"                        # tsebra|evm|evi_backbone|mikado
MERGED_GFF="$WORK_DIR/draft/merged.gff3"
EVM_WEIGHTS="$REPO_ROOT/config/evm_weights_s1_braker.txt"
# S14: EVM_WEIGHTS="$REPO_ROOT/config/evm_weights_cantulab.txt"

# Proteins + QC
PROTEINS_FA="$WORK_DIR/proteins.faa"
BUSCO_LINEAGE="eukaryota_odb10"           # override: viridiplantae_odb12, metazoa_odb10, ...
BUSCO_OUT="$WORK_DIR/busco_prot"
PSAURON_TSV="$WORK_DIR/psauron.tsv"
PRIORITY_TSV="$WORK_DIR/priority.tsv"
AGAT_OUT="$WORK_DIR/agat"
STAGE_QC_TSV="$WORK_DIR/qc/stage_qc.tsv"

CURATED_GFF="$WORK_DIR/curated.gff3"
RELEASE_TAG="species_ann.v0.1"

# ── S14 CantuLab directories & tools (fill if using S14) ──
ANNOT_DIR="$WORK_DIR"
REPEAT_DIR="$ANNOT_DIR/01-Repeats"
TRAINING_DIR="$ANNOT_DIR/02-Training_set"
AUGUSTUS_TRAIN_DIR="$ANNOT_DIR/03-Predictor_training/Augustus"
GENEMARK_TRAIN_DIR="$ANNOT_DIR/03-Predictor_training/Genemark"
AUGUSTUS_PRED_DIR="$ANNOT_DIR/04-Prediction/Augustus"
GENEMARK_PRED_DIR="$ANNOT_DIR/04-Prediction/Genemark"
EVM_DIR="$ANNOT_DIR/05-EVM"
POLISHING_DIR="$ANNOT_DIR/06-Polishing"
FILTERING_DIR="$ANNOT_DIR/07-Filtering"
REPEATMASKER_DIR="/path/to/RepeatMasker"
REPEAT_LIB="/path/to/repeat_library.lib"
GMAP_DIR="/path/to/gmap"
BLAT_DIR="/path/to/pblat"
PASA_DIR="/path/to/PASApipeline"
AUGUSTUS_DIR="/path/to/Augustus"
AUGUSTUS_CONFIG="${AUGUSTUS_DIR}/config"
GENEMARK_DIR="/path/to/gmes_linux_64"
EVM_TOOLS="/path/to/EVidenceModeler"
GFFREAD="$(command -v gffread || echo /path/to/gffread)"
GM_KEY_FILE="/path/to/gm_key.gz"


# ── Functional annotation (sibling repo) ──
# After qualify/release, run F1 in:
#   https://github.com/Xuzhen-Li/gene-function-annotation
# FUNCTION_DIR / DIAMOND_DB / EGGNOG_* live there.
