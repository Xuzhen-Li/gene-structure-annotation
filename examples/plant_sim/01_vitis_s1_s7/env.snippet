# Copy keys into config/local.env — paths are placeholders for the sim
species_label=Vitis_vinifera_sim
BUSCO_LINEAGE="viridiplantae_odb12"   # NOT bare eukaryota for a plant paper
COMPLEASM_LINEAGE="eudicots"
PROTEIN_DB="/path/to/OrthoDB_eudicots.faa"
TRUSTED_TE_LIB="/path/to/Vitis_TElib_trusted_vX.fa"  # sha256 in METHODS
CLEAN_TE_LIB="$TRUSTED_TE_LIB"
RELEASE_TAG="Vitis_sim.v0.1"
# OMARK_TAXID=29760 only if this really is Vitis — sim may keep commented
# A0: softmasked_fraction = homology to THIS trusted lib, NOT genome TE%.
# Lean trusted → lower fraction is expected; never boost with working/raw EDTA.
