species_label=Oryza_sativa_sim
BUSCO_LINEAGE="poales_odb10"          # or viridiplantae_odb12 — pick ONE and document
COMPLEASM_LINEAGE="poales"           # adjust to your Compleasm install names
PROTEIN_DB="/path/to/OrthoDB_poales_or_viridiplantae.faa"
TRUSTED_TE_LIB="/path/to/Oryza_TElib_trusted_vX.fa"
CLEAN_TE_LIB="$TRUSTED_TE_LIB"
RELEASE_TAG="Oryza_sim.v0.1"
# EDTA: --species rice when documented; do NOT copy grape --u 5.4e-9
# EDTA: copy docs/tools/edta.md Minimal (no μ). Do NOT paste TE_LIBRARY grape-panel block.
